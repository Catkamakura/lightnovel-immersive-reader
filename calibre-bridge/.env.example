# Copy to .env and tweak. (docker-compose reads it automatically.)

# 'ingest' = drop metadata-enriched EPUBs into CWA's ingest folder (recommended).
# 'calibredb' = add via the calibredb CLI to a plain Calibre library (no CWA).
BRIDGE_MODE=ingest

# Optional shared secret. If set, put the SAME value in the reader's settings ("书库 Token").
# BRIDGE_TOKEN=change-me
