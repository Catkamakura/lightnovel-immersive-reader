# ── secrets — NEVER commit (.env.example is the only env file that ships) ──
.env
**/.env
.env.local
*.key
*.pem

# ── node ──
node_modules/
npm-debug.log*

# ── python / calibre-bridge ──
.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# ── bridge local runtime / e2e artifacts ──
calibre-bridge/_e2e/
calibre-bridge/data/

# ── test/verify scratch ──
_shots*/
verify/_shots*/

# ── demo-video pipeline: generated media (the scripts + narration ARE committed) ──
_demo/tts-*.mp3
_demo/plan.json
_demo/offsets.json
_demo/base.mp4
_demo/narr-*.m4a
_demo/*.webm
_demo/frame-*.png
_demo/fail.png

# ── editor / OS ──
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
